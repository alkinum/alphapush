---
import Page from '@/components/common/Page.astro';
import { Card, CardContent } from '@/components/ui/card';
---

<Page>
  <Card>
    <CardContent class="flex flex-col items-center justify-center">
      <h1 class="text-2xl font-bold mb-4">Page Not Found</h1>
      <p class="text-sm mb-2">Sorry, the page you are looking for doesn't exist or has been moved.</p>
    </CardContent>
  </Card>
</Page>
