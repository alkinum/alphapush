---
import { env } from 'cloudflare:workers';
import { getSession } from '@/lib/auth';

import { PushTokenService } from '@/services/pushTokenService';

import TopUser from '../user/TopUser.vue';
import TopUserServer from '../user/TopUserServer.astro';

const session = await getSession(Astro.request, env.DB);
let pushToken = null;

if (session?.user?.email) {
  const pushTokenService = new PushTokenService(env.DB);
  pushToken = await pushTokenService.getPushToken(session.user.email);
}

const allowedEmails = import.meta.env.ALLOWED_EMAILS?.split(',').map((email: string) => email.trim()) || [];
const isAllowedUser = session?.user?.email && allowedEmails.includes(session.user.email);
---

<header class="app-navbar bg-card/85 border border-border/80 rounded-xl mt-4 mb-4 h-16 flex items-center backdrop-blur-sm" transition:persist>
  <div class="container mx-auto px-5 sm:px-6 flex items-center justify-between h-full">
    <div class="flex items-center">
      <a href="/" aria-label="AlphaPush home" class="flex items-center gap-3 rounded-lg text-[17px] font-semibold tracking-tight text-foreground">
        <img src="/icons/favicon.png" alt="" class="h-8 w-8 rounded-lg border border-white/15 bg-secondary p-1 shadow-sm" />
        <span>AlphaPush</span>
      </a>
    </div>
    {
      isAllowedUser ? (
        <>
          <TopUserServer email={session.user?.email ?? ''} nickname={session.user?.name ?? ''} />
          <TopUser
            client:only="vue"
            userInfo={{
              email: session.user?.email ?? '',
              nickname: session.user?.name ?? '',
              role: session.user?.role ?? 'user',
              pushToken: pushToken ?? undefined,
            }}
          />
        </>
      ) : null
    }
  </div>
</header>
