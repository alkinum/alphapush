{
  "name": "alphapush",
  "type": "module",
  "version": "0.5.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "astro dev",
    "build": "turbo run build && astro check && astro build",
    "preview": "astro preview",
    "type-check": "astro check",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply alphapush-prod --local",
    "db:migrate:prod": "wrangler d1 migrations apply alphapush-prod --remote",
    "db:migrate:dev": "wrangler d1 migrations apply --env dev alphapush-dev --remote",
    "deploy:dev": "pnpm run build && wrangler pages deploy dist --branch dev",
    "deploy:prod": "pnpm run build && wrangler pages deploy dist --branch main",
    "prebuild": "node scripts/prebuild.mjs",
    "generate:worker-types": "wrangler types"
  },
  "license": "MIT",
  "homepage": "https://github.com/alkinum/alphapush",
  "repository": "https://github.com/alkinum/alphapush.git",
  "author": "alkinum.io",
  "bugs": "https://github.com/alkinum/alphapush/issues",
  "maintainers": [
    "BackRunner"
  ],
  "dependencies": {
    "@alkinum/alphapush-encryption": "workspace:*",
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.1.0",
    "@astrojs/vue": "^7.0.1",
    "@block65/webcrypto-web-push": "^1.0.2",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "^1.23.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vueuse/core": "^14.3.0",
    "astro": "^7.0.5",
    "base64-arraybuffer": "^1.0.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "nanoid": "^5.1.16",
    "path-browserify-esm": "^1.0.6",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tanstack/vue-table": "^8.21.3",
    "@types/node": "^26.1.0",
    "@types/web-push": "^3.6.4",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.10.2",
    "wrangler": "^4.106.0"
  }
}
