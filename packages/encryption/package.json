{
  "name": "@alkinum/alphapush-encryption",
  "version": "0.1.1",
  "description": "End to end encryption for AlphaPush",
  "main": "dist/encryption.mjs",
  "typings": "dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=dev rollup -c rollup.config.mjs -w",
    "watch": "cross-env NODE_ENV=dev rollup -c rollup.config.mjs -w",
    "build": "rimraf ./dist && tsc && cross-env NODE_ENV=production rollup -c rollup.config.mjs && rimraf ./dist/lib",
    "lint": "eslint \"src/**/*.ts\""
  },
  "author": "BackRunner",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/parser": "^8.62.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
